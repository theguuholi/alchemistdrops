<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Alchemistdrops" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>

    <%!-- SEO Meta Tags --%>
    <%= if assigns[:meta_description] do %>
      <meta name="description" content={@meta_description} />
      <meta property="og:description" content={@meta_description} />
      <meta name="twitter:description" content={@meta_description} />
    <% end %>

    <%= if assigns[:page_title] do %>
      <meta property="og:title" content={@page_title} />
      <meta name="twitter:title" content={@page_title} />
    <% end %>

    <%= if assigns[:meta_url] do %>
      <meta property="og:url" content={@meta_url} />
      <link rel="canonical" href={@meta_url} />
    <% end %>

    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body>
    <header class="navbar px-4 sm:px-6 lg:px-8">
      <div class="flex-1">
        <a href="/" class="flex-1 flex w-fit items-center gap-2">
          <img src={~p"/images/logo.svg"} width="36" />
        </a>
      </div>
      <div class="flex-none">
        <ul class="flex flex-column px-1 space-x-4 items-center">
          <li>
            <.theme_toggle />
          </li>
          <li>
            <ul class="menu menu-horizontal w-full relative z-10 flex items-center gap-4 px-4 sm:px-6 lg:px-8 justify-end">
              <li>
                <.link href={~p"/courses"}>Courses</.link>
              </li>
              <li>
                <.link href={~p"/blog"}>Blog</.link>
              </li>
              <%= if @current_scope do %>
                <li :if={@current_scope.user.role == :admin} class="relative group">
                  <button class="flex items-center gap-1 text-warning font-medium">
                    Admin
                    <.icon name="hero-chevron-down" class="w-4 h-4 transition-transform group-hover:rotate-180" />
                  </button>
                  <ul class="invisible group-hover:visible opacity-0 group-hover:opacity-100 absolute right-0 top-full mt-1 w-40 bg-base-200 rounded-lg py-1 shadow-xl transition-all">
                    <li>
                      <.link href={~p"/admin/courses"} class="block px-4 py-2 hover:bg-base-300">Courses</.link>
                    </li>
                    <li>
                      <.link href={~p"/admin/posts"} class="block px-4 py-2 hover:bg-base-300">Posts</.link>
                    </li>
                    <li>
                      <.link href={~p"/admin/users"} class="block px-4 py-2 hover:bg-base-300">Users</.link>
                    </li>
                  </ul>
                </li>
                <li>
                  <.link href={~p"/users/settings"}>{@current_scope.user.email}</.link>
                </li>
                <li>
                  <.link href={~p"/users/log-out"} method="delete">Log out</.link>
                </li>
              <% else %>
                <li>
                  <.link href={~p"/users/register"}>Register</.link>
                </li>
                <li>
                  <.link href={~p"/users/log-in"}>Log in</.link>
                </li>
              <% end %>
            </ul>
          </li>
        </ul>
      </div>
    </header>
    {@inner_content}
  </body>
</html>
