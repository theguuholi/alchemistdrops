<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Alchemistdrops" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>

    <%!-- SEO Meta Tags --%>
    <%= if assigns[:meta_description] do %>
      <meta name="description" content={@meta_description} />
      <meta property="og:description" content={@meta_description} />
      <meta name="twitter:description" content={@meta_description} />
    <% end %>

    <%= if assigns[:page_title] do %>
      <meta property="og:title" content={@page_title} />
      <meta name="twitter:title" content={@page_title} />
    <% end %>

    <%= if assigns[:meta_url] do %>
      <meta property="og:url" content={@meta_url} />
      <link rel="canonical" href={@meta_url} />
    <% end %>

    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body class="min-h-screen bg-base-100">
    <header class="bg-base-200 border-b border-base-300">
      <nav class="flex items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        <%!-- Logo --%>
        <a href="/" class="flex items-center gap-2">
          <img src={~p"/images/logo.svg"} width="36" alt="Alchemistdrops" />
        </a>

        <%!-- Navigation Links --%>
        <ul class="flex items-center gap-4 sm:gap-6 text-sm">
          <li>
            <.link href={~p"/courses"} class="hover:text-primary transition-colors">
              Courses
            </.link>
          </li>
          <li>
            <.link href={~p"/blog"} class="hover:text-primary transition-colors">
              Blog
            </.link>
          </li>

          <%= if @current_scope do %>
            <%= if @current_scope.user.role == :admin do %>
              <li>
                <details class="relative">
                  <summary class="text-warning cursor-pointer list-none flex items-center gap-1 hover:text-warning/80">
                    Admin <.icon name="hero-chevron-down" class="w-3 h-3" />
                  </summary>
                  <ul class="absolute right-0 mt-2 w-40 bg-base-200 border border-base-300 rounded-lg shadow-xl z-50 py-2">
                    <li>
                      <.link href={~p"/admin/posts"} class="block px-4 py-2 hover:bg-base-300">
                        Posts
                      </.link>
                    </li>
                    <li>
                      <.link href={~p"/admin/courses"} class="block px-4 py-2 hover:bg-base-300">
                        Courses
                      </.link>
                    </li>
                    <li>
                      <.link
                        href={~p"/admin/enrollments"}
                        class="block px-4 py-2 hover:bg-base-300"
                      >
                        Enrollments
                      </.link>
                    </li>
                    <li>
                      <.link href={~p"/admin/users"} class="block px-4 py-2 hover:bg-base-300">
                        Users
                      </.link>
                    </li>
                  </ul>
                </details>
              </li>
            <% end %>

            <li>
              <.link
                href={~p"/users/settings"}
                class="hover:text-primary transition-colors truncate max-w-[100px] sm:max-w-[150px] inline-block"
              >
                {@current_scope.user.email}
              </.link>
            </li>
            <li>
              <.link
                href={~p"/users/log-out"}
                method="delete"
                class="hover:text-error transition-colors"
              >
                Log out
              </.link>
            </li>
          <% else %>
            <li>
              <.link href={~p"/users/register"} class="hover:text-primary transition-colors">
                Register
              </.link>
            </li>
            <li>
              <.link href={~p"/users/log-in"} class="hover:text-primary transition-colors">
                Log in
              </.link>
            </li>
          <% end %>

          <li>
            <.theme_toggle />
          </li>
        </ul>
      </nav>
    </header>
    {@inner_content}
  </body>
</html>
