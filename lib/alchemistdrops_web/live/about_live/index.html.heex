<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="min-h-screen bg-base-100">
    <.hero_section
      profile={@profile}
      linkedin_url={@linkedin_url}
      email={@email}
    />

    <%!-- About — tagline + bio --%>
    <section
      class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-b border-base-300"
      aria-labelledby="about-heading"
    >
      <h2
        id="about-heading"
        class="text-sm font-semibold uppercase tracking-widest text-primary mb-6"
      >
        About
      </h2>
      <p class="text-xl sm:text-2xl font-light text-base-content/90 leading-relaxed max-w-3xl mb-8">
        {@profile.tagline}
      </p>
      <div class="space-y-4 text-base-content/80 leading-relaxed max-w-3xl">
        <%= for paragraph <- @profile.bio do %>
          <p>{paragraph}</p>
        <% end %>
      </div>
      <div class="mt-10 flex flex-wrap gap-4 text-sm">
        <div class="flex items-center gap-2 text-base-content/70">
          <.icon name="hero-academic-cap" class="w-5 h-5 text-primary/80" />
          <span>{@profile.education}</span>
        </div>
        <div class="flex items-center gap-2 text-base-content/70">
          <.icon name="hero-trophy" class="w-5 h-5 text-primary/80" />
          <span>{@profile.honors}</span>
        </div>
      </div>
    </section>

    <%!-- Skills — pills --%>
    <section
      class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-b border-base-300"
      aria-labelledby="skills-heading"
    >
      <h2
        id="skills-heading"
        class="text-sm font-semibold uppercase tracking-widest text-primary mb-8"
      >
        Core stack & practices
      </h2>
      <ul class="flex flex-wrap gap-2">
        <%= for skill <- @skills do %>
          <li>
            <span class="inline-block px-4 py-2 rounded-lg bg-base-200 border border-base-300 text-sm font-medium text-base-content/90 hover:border-primary/30 hover:bg-primary/5 transition-colors">
              {skill}
            </span>
          </li>
        <% end %>
      </ul>
    </section>

    <%!-- Career journey — timeline style, edgy --%>
    <section
      class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-b border-base-300"
      aria-labelledby="career-heading"
    >
      <h2
        id="career-heading"
        class="text-sm font-semibold uppercase tracking-widest text-primary mb-12"
      >
        Career journey
      </h2>
      <div class="relative">
        <div
          class="absolute left-[11px] top-2 bottom-2 w-px bg-gradient-to-b from-primary/50 via-base-300 to-transparent"
          aria-hidden="true"
        >
        </div>
        <ul class="space-y-0">
          <%= for {entry, idx} <- Enum.with_index(@career) do %>
            <li class="relative flex gap-8 pb-12 last:pb-0">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/20 border-2 border-primary flex items-center justify-center mt-0.5 z-10">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              </div>
              <div class="flex-1 min-w-0 pt-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                  <h3 class="text-lg font-semibold text-base-content">
                    {entry.role} · {entry.company}
                  </h3>
                  <span class="text-sm text-base-content/60">
                    {entry.period}
                  </span>
                </div>
                <p class="text-sm text-base-content/60 mb-3">
                  {entry.location}
                </p>
                <ul class="space-y-1.5">
                  <%= for highlight <- entry.highlights do %>
                    <li class="flex gap-2 text-sm text-base-content/80">
                      <span class="text-primary mt-1.5 flex-shrink-0">▸</span>
                      <span>{highlight}</span>
                    </li>
                  <% end %>
                </ul>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </section>

    <%!-- Portfolio — placeholder for future --%>
    <section
      class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-b border-base-300"
      aria-labelledby="portfolio-heading"
    >
      <h2
        id="portfolio-heading"
        class="text-sm font-semibold uppercase tracking-widest text-primary mb-8"
      >
        Portfolio
      </h2>
      <div class="rounded-2xl border-2 border-dashed border-base-300 bg-base-200/50 p-12 text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-base-300 flex items-center justify-center">
          <.icon name="hero-folder-open" class="w-8 h-8 text-base-content/40" />
        </div>
        <h3 class="text-xl font-semibold text-base-content mb-2">
          Coming soon
        </h3>
        <p class="text-base-content/70 max-w-md mx-auto">
          Selected projects and case studies will be linked here.
        </p>
      </div>
    </section>

    <%!-- Digital Twin chat --%>
    <section
      class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-b border-base-300"
      aria-labelledby="digital-twin-heading"
    >
      <h2
        id="digital-twin-heading"
        class="text-sm font-semibold uppercase tracking-widest text-primary mb-8"
      >
        Chat with my Digital Twin
      </h2>
      <%= if @digital_twin_available do %>
        <div class="rounded-2xl border border-base-300 bg-base-200/50 overflow-hidden">
          <div
            id="digital-twin-messages"
            class="min-h-[200px] max-h-[400px] overflow-y-auto p-4 space-y-4"
          >
            <%= if Enum.empty?(@chat_messages) do %>
              <p class="text-base-content/60 text-sm">
                Ask anything about my career, experience, or tech stack. I'll answer as Gustavo's digital twin.
              </p>
            <% else %>
              <%= for msg <- @chat_messages do %>
                <div class={[
                  "flex",
                  if(msg.role == "user", do: "justify-end", else: "justify-start")
                ]}>
                  <div class={[
                    "max-w-[85%] rounded-xl px-4 py-3 text-sm",
                    if(msg.role == "user",
                      do: "bg-primary text-primary-content",
                      else: "bg-base-300 text-base-content"
                    )
                  ]}>
                    <p class="whitespace-pre-wrap">{msg.content}</p>
                  </div>
                </div>
              <% end %>
            <% end %>
            <%= if @chat_loading do %>
              <div class="flex justify-start">
                <div class="rounded-xl px-4 py-3 bg-base-300 text-base-content/70 text-sm">
                  <span class="inline-flex gap-1">
                    <.icon name="hero-arrow-path" class="w-4 h-4 animate-spin" /> Thinking...
                  </span>
                </div>
              </div>
            <% end %>
          </div>
          <form
            id="digital-twin-form"
            phx-submit="send_message"
            class="p-4 border-t border-base-300 flex gap-2"
          >
            <input
              type="text"
              name="message"
              placeholder="Ask about my career..."
              class="input input-bordered flex-1 input-sm"
              autocomplete="off"
              disabled={@chat_loading}
            />
            <button
              type="submit"
              class="btn btn-primary btn-sm gap-1"
              disabled={@chat_loading}
              aria-label="Send message"
            >
              <.icon name="hero-arrow-right" class="w-4 h-4" /> Send
            </button>
          </form>
        </div>
      <% else %>
        <div class="rounded-2xl border-2 border-dashed border-base-300 bg-base-200/50 p-8 text-center">
          <p class="text-base-content/70">
            Set <code class="px-1 py-0.5 rounded bg-base-300 text-sm">OPENROUTER_API_KEY</code>
            in your environment (e.g. from <code class="px-1 py-0.5 rounded bg-base-300 text-sm">.env</code>) to enable the Digital Twin chat.
          </p>
        </div>
      <% end %>
    </section>

    <%!-- CTA / Contact strip --%>
    <section
      class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20"
      aria-labelledby="contact-heading"
    >
      <div class="rounded-2xl bg-gradient-to-br from-primary/10 to-secondary/10 border border-primary/20 p-8 sm:p-12 text-center">
        <h2 id="contact-heading" class="text-2xl sm:text-3xl font-bold text-base-content mb-4">
          Let's connect
        </h2>
        <p class="text-base-content/80 max-w-xl mx-auto mb-8">
          Open to collaboration, speaking, and impactful engineering discussions.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={@linkedin_url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary gap-2"
          >
            <.icon name="hero-arrow-top-right-on-square" class="w-5 h-5" /> LinkedIn
          </a>
          <a href={"mailto:#{@email}"} class="btn btn-outline gap-2">
            <.icon name="hero-envelope" class="w-5 h-5" /> Email
          </a>
        </div>
      </div>
    </section>
  </div>
</Layouts.app>
