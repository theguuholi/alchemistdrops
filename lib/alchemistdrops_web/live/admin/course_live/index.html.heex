<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    <div class="flex items-center gap-3">
      <.icon name="hero-academic-cap" class="size-7 text-primary" />
      <span>Manage Courses</span>
    </div>
    <:subtitle>
      Create and manage your course catalog
    </:subtitle>
    <:actions>
      <.button variant="primary" navigate={~p"/admin/courses/new"}>
        <.icon name="hero-plus" class="size-4" /> New Course
      </.button>
    </:actions>
  </.header>

  <%!-- Mobile-first card view for small screens --%>
  <div class="block md:hidden space-y-4" id="courses-mobile">
    <div
      :for={{id, course} <- @streams.courses}
      id={"#{id}-mobile"}
      class="card bg-base-200 shadow-md hover:shadow-lg transition-shadow duration-200"
    >
      <div class="card-body p-4">
        <div class="flex items-start justify-between gap-2">
          <div class="flex-1 min-w-0">
            <h3 class="card-title text-base font-semibold truncate">
              {course.title}
            </h3>
            <p class="text-sm text-base-content/70 line-clamp-2 mt-1">
              {course.description}
            </p>
          </div>
          <div class={[
            "badge badge-sm whitespace-nowrap",
            course.published && "badge-success",
            !course.published && "badge-warning"
          ]}>
            {if course.published, do: "Published", else: "Draft"}
          </div>
        </div>

        <div class="flex items-center gap-4 mt-3 text-sm text-base-content/60">
          <span class="flex items-center gap-1">
            <.icon name="hero-currency-dollar" class="size-4" />
            {format_price(course.price)}
          </span>
        </div>

        <div class="card-actions justify-end mt-3 pt-3 border-t border-base-300">
          <.link navigate={~p"/admin/courses/#{course}"} class="btn btn-ghost btn-sm">
            <.icon name="hero-eye" class="size-4" /> View
          </.link>
          <.link navigate={~p"/admin/courses/#{course}/edit"} class="btn btn-ghost btn-sm">
            <.icon name="hero-pencil" class="size-4" /> Edit
          </.link>
          <button
            phx-click={JS.push("delete", value: %{id: course.id}) |> hide("##{id}-mobile")}
            data-confirm="Are you sure you want to delete this course? This action cannot be undone."
            class="btn btn-ghost btn-sm text-error"
          >
            <.icon name="hero-trash" class="size-4" /> Delete
          </button>
        </div>
      </div>
    </div>

    <div :if={@courses_empty?} class="text-center py-12 text-base-content/60">
      <.icon name="hero-academic-cap" class="size-16 mx-auto mb-4 opacity-30" />
      <p class="text-lg">No courses yet</p>
      <p class="text-sm mt-1">Create your first course to get started</p>
    </div>
  </div>

  <%!-- Desktop table view --%>
  <div class="hidden md:block overflow-x-auto">
    <.table
      id="courses"
      rows={@streams.courses}
      row_click={fn {_id, course} -> JS.navigate(~p"/admin/courses/#{course}") end}
    >
      <:col :let={{_id, course}} label="Title">
        <div class="flex items-center gap-3">
          <div class="font-medium">{course.title}</div>
        </div>
      </:col>
      <:col :let={{_id, course}} label="Status">
        <div class={[
          "badge badge-sm",
          course.published && "badge-success",
          !course.published && "badge-warning"
        ]}>
          {if course.published, do: "Published", else: "Draft"}
        </div>
      </:col>
      <:col :let={{_id, course}} label="Price">
        {format_price(course.price)}
      </:col>
      <:action :let={{_id, course}}>
        <div class="sr-only">
          <.link navigate={~p"/admin/courses/#{course}"}>View</.link>
        </div>
        <.link navigate={~p"/admin/courses/#{course}/edit"} class="link link-hover text-primary">
          Edit
        </.link>
      </:action>
      <:action :let={{id, course}}>
        <.link
          phx-click={JS.push("delete", value: %{id: course.id}) |> hide("##{id}")}
          data-confirm="Are you sure you want to delete this course? This action cannot be undone."
          class="link link-hover text-error"
        >
          Delete
        </.link>
      </:action>
    </.table>

    <div :if={@courses_empty?} class="text-center py-12 text-base-content/60">
      <.icon name="hero-academic-cap" class="size-16 mx-auto mb-4 opacity-30" />
      <p class="text-lg">No courses yet</p>
      <p class="text-sm mt-1">Create your first course to get started</p>
    </div>
  </div>
</Layouts.app>
