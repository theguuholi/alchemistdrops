<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Courses
    <:actions>
      <.button variant="primary" navigate={~p"/admin/courses/new"}>
        <.icon name="hero-plus" class="w-4 h-4" /> New Course
      </.button>
    </:actions>
  </.header>

  <%= if @courses_empty? do %>
    <p id="no-courses" class="text-center py-12 text-base-content/60">No courses yet</p>
  <% else %>
    <.table id="courses-table" rows={@streams.courses}>
      <:col :let={{_id, course}} label="Title">
        <span class="font-medium">{course.title}</span>
      </:col>
      <:col :let={{_id, course}} label="Price">
        <%= if price_free?(course.price) do %>
          <span class="text-success">Free</span>
        <% else %>
          {format_price(course.price)}
        <% end %>
      </:col>
      <:col :let={{_id, course}} label="Status">
        <span class={[
          "badge badge-sm",
          if(course.published, do: "badge-success", else: "badge-warning")
        ]}>
          {if course.published, do: "Published", else: "Draft"}
        </span>
      </:col>
      <:action :let={{_id, course}}>
        <.link navigate={~p"/admin/courses/#{course}"} class="link link-primary">View</.link>
      </:action>
      <:action :let={{_id, course}}>
        <.link navigate={~p"/admin/courses/#{course}/edit"} class="link link-primary">Edit</.link>
      </:action>
      <:action :let={{id, course}}>
        <.link
          phx-click={JS.push("delete", value: %{id: course.id}) |> hide("##{id}")}
          data-confirm="Are you sure you want to delete this course?"
          class="link link-error"
        >
          Delete
        </.link>
      </:action>
    </.table>
  <% end %>
</Layouts.app>
