<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    <div class="flex items-center gap-3">
      <.icon name="hero-academic-cap" class="size-7 text-primary" />
      <span class="truncate">{@course.title}</span>
    </div>
    <:subtitle>
      <div class="flex flex-wrap items-center gap-2 mt-1">
        <span class={[
          "badge",
          @course.published && "badge-success",
          !@course.published && "badge-warning"
        ]}>
          {if @course.published, do: "Published", else: "Draft"}
        </span>
        <span class="badge badge-outline">
          {format_price(@course.price)}
        </span>
      </div>
    </:subtitle>
    <:actions>
      <.button navigate={~p"/admin/courses/#{@course}/edit?return_to=show"}>
        <.icon name="hero-pencil" class="size-4" /> Edit Course
      </.button>
    </:actions>
  </.header>

  <%!-- Course Details Card --%>
  <div class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%!-- Main Content --%>
    <div class="lg:col-span-2 space-y-6">
      <%!-- Description Card --%>
      <div class="card bg-base-200">
        <div class="card-body p-4 sm:p-6">
          <h3 class="card-title text-base mb-3">
            <.icon name="hero-document-text" class="size-5" /> Description
          </h3>
          <p class="text-base-content/80 whitespace-pre-wrap">
            {@course.description}
          </p>
          <div :if={@course.body} class="mt-4 pt-4 border-t border-base-300">
            <h4 class="font-medium text-sm text-base-content/70 mb-2">Full Content</h4>
            <div class="prose prose-sm max-w-none text-base-content/80">
              {@course.body}
            </div>
          </div>
        </div>
      </div>

      <%!-- Lessons Card --%>
      <div class="card bg-base-200">
        <div class="card-body p-4 sm:p-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
            <h3 class="card-title text-base">
              <.icon name="hero-play-circle" class="size-5" /> Lessons
              <span class="badge badge-sm badge-primary">{length(@course.lessons)}</span>
            </h3>
            <.button
              variant="primary"
              navigate={~p"/admin/courses/#{@course}/lessons/new"}
              class="btn-sm w-full sm:w-auto"
            >
              <.icon name="hero-plus" class="size-4" /> Add Lesson
            </.button>
          </div>

          <div :if={@course.lessons == []} class="text-center py-8 text-base-content/60">
            <.icon name="hero-play-circle" class="size-12 mx-auto mb-3 opacity-30" />
            <p>No lessons yet</p>
            <p class="text-sm mt-1">Add your first lesson to get started</p>
          </div>

          <div :if={@course.lessons != []} class="space-y-3" id="lessons-list">
            <div
              :for={lesson <- @course.lessons}
              id={"lesson-#{lesson.id}"}
              class="flex flex-col sm:flex-row sm:items-center gap-3 p-3 rounded-lg bg-base-100 border border-base-300 hover:border-primary/30 transition-colors"
            >
              <div class="flex items-center gap-3 flex-1 min-w-0">
                <div class="badge badge-outline badge-sm shrink-0">
                  {lesson.order + 1}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="font-medium truncate">{lesson.title}</div>
                  <div :if={lesson.duration} class="text-xs text-base-content/60 mt-0.5">
                    <.icon name="hero-clock" class="size-3 inline" />
                    {lesson.duration} min
                  </div>
                </div>
                <div class={[
                  "badge badge-sm shrink-0",
                  lesson.published && "badge-success",
                  !lesson.published && "badge-warning"
                ]}>
                  {if lesson.published, do: "Published", else: "Draft"}
                </div>
              </div>

              <div class="flex items-center gap-2 justify-end sm:justify-start">
                <.link
                  navigate={~p"/admin/courses/#{@course}/lessons/#{lesson}/edit"}
                  class="btn btn-ghost btn-sm"
                >
                  <.icon name="hero-pencil" class="size-4" />
                  <span class="sm:hidden">Edit</span>
                </.link>
                <button
                  phx-click={
                    JS.push("delete_lesson", value: %{id: lesson.id})
                    |> hide("#lesson-#{lesson.id}")
                  }
                  data-confirm="Are you sure you want to delete this lesson?"
                  class="btn btn-ghost btn-sm text-error"
                >
                  <.icon name="hero-trash" class="size-4" />
                  <span class="sm:hidden">Delete</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Sidebar --%>
    <div class="space-y-6">
      <%!-- Stripe Integration Card --%>
      <div class="card bg-base-200">
        <div class="card-body p-4 sm:p-6">
          <h3 class="card-title text-base mb-3">
            <.icon name="hero-credit-card" class="size-5" /> Stripe Integration
          </h3>
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-base-content/60">Product ID</dt>
              <dd class="font-mono text-xs mt-1 break-all">
                {@course.stripe_product_id || "Not configured"}
              </dd>
            </div>
            <div>
              <dt class="text-base-content/60">Price ID</dt>
              <dd class="font-mono text-xs mt-1 break-all">
                {@course.stripe_price_id || "Not configured"}
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <%!-- Metadata Card --%>
      <div class="card bg-base-200">
        <div class="card-body p-4 sm:p-6">
          <h3 class="card-title text-base mb-3">
            <.icon name="hero-information-circle" class="size-5" /> Details
          </h3>
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-base-content/60">Created</dt>
              <dd>{Calendar.strftime(@course.inserted_at, "%B %d, %Y")}</dd>
            </div>
            <div>
              <dt class="text-base-content/60">Last Updated</dt>
              <dd>{Calendar.strftime(@course.updated_at, "%B %d, %Y")}</dd>
            </div>
            <div :if={@course.thumbnail_url}>
              <dt class="text-base-content/60">Thumbnail</dt>
              <dd class="mt-2">
                <img
                  src={@course.thumbnail_url}
                  alt="Course thumbnail"
                  class="rounded-lg max-h-32 object-cover"
                />
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <%!-- Quick Actions Card --%>
      <div class="card bg-base-200">
        <div class="card-body p-4 sm:p-6">
          <h3 class="card-title text-base mb-3">
            <.icon name="hero-bolt" class="size-5" /> Quick Actions
          </h3>
          <div class="space-y-2">
            <.link navigate={~p"/admin/courses"} class="btn btn-ghost btn-sm w-full justify-start">
              <.icon name="hero-arrow-left" class="size-4" /> Back to Courses
            </.link>
            <.link
              navigate={~p"/courses/#{@course}"}
              class="btn btn-ghost btn-sm w-full justify-start"
            >
              <.icon name="hero-eye" class="size-4" /> View Public Page
            </.link>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
