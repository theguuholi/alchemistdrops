<Layouts.app flash={@flash} current_scope={@current_scope}>
  <article class="max-w-6xl mx-auto" aria-labelledby="users-heading">
    <.header>
      <h1 id="users-heading">Users</h1>
      <:subtitle>Manage platform users and their roles</:subtitle>
    </.header>

    <section class="mt-6 sm:mt-8" aria-label="Users list">
      <%= if @users_empty? do %>
        <div
          class="text-center py-12 text-base-content/60"
          role="status"
          aria-live="polite"
        >
          <.icon name="hero-user-group" class="w-12 h-12 mx-auto mb-4 opacity-50" />
          <p class="text-lg">No users yet</p>
          <p class="text-sm mt-2">Users will appear here when they register</p>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <.table id="users-table" rows={@streams.users}>
            <:col :let={{_id, user}} label="Email">
              <span class="truncate max-w-[150px] sm:max-w-[250px] inline-block">
                {user.email}
              </span>
            </:col>
            <:col :let={{_id, user}} label="Role">
              <span
                class={["badge badge-sm", role_class(user.role)]}
                role="status"
              >
                {user.role}
              </span>
            </:col>
            <:col :let={{_id, user}} label="Confirmed">
              <%= if user.confirmed_at do %>
                <span class="badge badge-success badge-sm" role="status">Yes</span>
              <% else %>
                <span class="badge badge-warning badge-sm" role="status">No</span>
              <% end %>
            </:col>
            <:col :let={{_id, user}} label="Joined">
              <time datetime={user.inserted_at} class="text-sm text-base-content/70">
                {format_date(user.inserted_at)}
              </time>
            </:col>
            <:action :let={{_id, user}}>
              <%= if user.role == :user do %>
                <button
                  phx-click="make_admin"
                  phx-value-id={user.id}
                  class="link link-warning text-sm"
                  aria-label={"Make #{user.email} an admin"}
                >
                  Make Admin
                </button>
              <% else %>
                <button
                  phx-click="remove_admin"
                  phx-value-id={user.id}
                  class="link link-error text-sm"
                  aria-label={"Remove admin role from #{user.email}"}
                >
                  Remove Admin
                </button>
              <% end %>
            </:action>
          </.table>
        </div>
      <% end %>
    </section>
  </article>
</Layouts.app>
