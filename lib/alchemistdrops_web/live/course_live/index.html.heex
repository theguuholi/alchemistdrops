<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="space-y-4 sm:space-y-6 lg:space-y-8 max-w-7xl mx-auto w-full overflow-hidden">
    <%!-- Hero Section --%>
    <header class="text-center">
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-primary mb-2 sm:mb-3">
        Explore Our Courses
      </h1>
      <p class="text-sm sm:text-base lg:text-lg text-base-content/70 max-w-2xl mx-auto px-2">
        Discover transformative learning experiences crafted by industry experts
      </p>
    </header>

    <%!-- Courses Grid --%>
    <section aria-label="Available courses">
      <%= if Enum.empty?(@courses) do %>
        <%!-- Empty State --%>
        <div class="text-center py-8 sm:py-12 lg:py-16 card bg-base-200">
          <.icon
            name="hero-academic-cap"
            class="w-12 h-12 sm:w-16 sm:h-16 mx-auto text-base-content/30 mb-3"
          />
          <h2 class="text-lg sm:text-xl font-semibold text-base-content mb-2">
            No courses available yet
          </h2>
          <p class="text-sm text-base-content/60">
            Check back soon for exciting new content
          </p>
        </div>
      <% else %>
        <%!-- Course Cards Grid --%>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 lg:gap-6">
          <%= for course <- @courses do %>
            <article
              data-role="course-card"
              class="card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 border border-base-300 hover:border-primary/50 overflow-hidden"
            >
              <%!-- Course Thumbnail --%>
              <figure class="aspect-video relative overflow-hidden">
                <img
                  src={course.thumbnail_url || ~p"/images/course-placeholder.svg"}
                  alt={"Thumbnail for #{course.title}"}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />

                <%!-- Enrollment Badge --%>
                <%= if Map.get(course, :enrolled, false) do %>
                  <div class="absolute top-2 right-2 sm:top-3 sm:right-3 badge badge-success badge-sm gap-1 shadow-lg">
                    <.icon name="hero-check-circle" class="w-3 h-3" />
                    <span class="hidden sm:inline text-xs">Enrolled</span>
                  </div>
                <% end %>
              </figure>

              <%!-- Course Content --%>
              <div class="card-body p-3 sm:p-4 min-w-0">
                <%!-- Price Badge --%>
                <div class="mb-1.5 sm:mb-2">
                  <span class={[
                    "badge badge-xs sm:badge-sm gap-1",
                    Money.zero?(course.price) && "badge-success",
                    !Money.zero?(course.price) && "badge-info"
                  ]}>
                    {format_price(course.price)}
                  </span>
                </div>

                <%!-- Title --%>
                <h3 class="card-title text-sm sm:text-base text-base-content hover:text-primary transition-colors break-words line-clamp-2">
                  {course.title}
                </h3>

                <%!-- Description --%>
                <p class="text-xs sm:text-sm text-base-content/70 line-clamp-2 flex-1 break-words">
                  {course.description}
                </p>

                <%!-- Action Button --%>
                <div class="card-actions justify-end mt-2 sm:mt-3">
                  <.link
                    navigate={~p"/courses/#{course}"}
                    class="btn btn-primary btn-xs sm:btn-sm gap-1.5"
                    aria-label={"View details for #{course.title}"}
                  >
                    <%= if Map.get(course, :enrolled, false) do %>
                      <.icon name="hero-arrow-right" class="w-3 h-3 sm:w-4 sm:h-4" />
                      <span class="text-xs sm:text-sm">Continue</span>
                    <% else %>
                      <.icon name="hero-eye" class="w-3 h-3 sm:w-4 sm:h-4" />
                      <span class="text-xs sm:text-sm">View</span>
                    <% end %>
                  </.link>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</Layouts.app>
