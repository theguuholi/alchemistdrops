<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="space-y-4 sm:space-y-6 max-w-6xl mx-auto">
    <%!-- Back Button --%>
    <.link
      navigate={~p"/courses"}
      class="btn btn-ghost btn-sm gap-2"
    >
      <.icon name="hero-arrow-left" class="w-4 h-4 sm:w-5 sm:h-5" /> Back to Courses
    </.link>

    <%!-- Course Header --%>
    <article class="card bg-base-100 shadow-lg border border-base-300">
      <div class="flex flex-col lg:grid lg:grid-cols-2 gap-0">
        <%!-- Course Image --%>
        <figure class="aspect-video relative">
          <img
            src={@course.thumbnail_url || ~p"/images/course-placeholder.svg"}
            alt={"Thumbnail for #{@course.title}"}
            class="w-full h-full object-cover"
          />
        </figure>

        <%!-- Course Info --%>
        <div class="card-body p-4 sm:p-6 lg:p-8">
          <%!-- Price Badge --%>
          <div class="mb-3 sm:mb-4">
            <span class={[
              "badge badge-md sm:badge-lg gap-1",
              Money.zero?(@course.price) && "badge-success",
              !Money.zero?(@course.price) && "badge-info"
            ]}>
              {format_price(@course.price)}
            </span>
          </div>

          <%!-- Title --%>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-base-content mb-3 sm:mb-4">
            {@course.title}
          </h1>

          <%!-- Description --%>
          <p class="text-base sm:text-lg text-base-content/70 mb-4 sm:mb-6">
            {@course.description}
          </p>

          <%!-- Course Stats --%>
          <div class="flex flex-wrap gap-4 sm:gap-6 mb-6 sm:mb-8 text-base-content/70">
            <div class="flex items-center gap-2">
              <.icon name="hero-book-open" class="w-4 h-4 sm:w-5 sm:h-5" />
              <span class="text-sm sm:text-base">{length(@lessons)} Lessons</span>
            </div>
            <%= if @total_duration > 0 do %>
              <div class="flex items-center gap-2">
                <.icon name="hero-clock" class="w-4 h-4 sm:w-5 sm:h-5" />
                <span class="text-sm sm:text-base">{@total_duration} min</span>
              </div>
            <% end %>
          </div>

          <%!-- Action Button --%>
          <div class="mt-auto">
            <%= cond do %>
              <%!-- Logged in and enrolled --%>
              <% @enrolled && Map.has_key?(@current_scope || %{}, :user) -> %>
                <div class="space-y-3">
                  <div class="alert alert-success">
                    <.icon name="hero-check-circle" class="w-6 h-6" />
                    <span>You're enrolled in this course</span>
                  </div>
                  <%= if length(@lessons) > 0 do %>
                    <.link
                      navigate={~p"/student/courses/#{@course.id}/lessons"}
                      class="btn btn-primary w-full gap-2"
                    >
                      <.icon name="hero-play" class="w-6 h-6" /> Start Learning
                    </.link>
                  <% end %>
                </div>

                <%!-- Logged in, not enrolled, free course --%>
              <% !@enrolled && Map.has_key?(@current_scope || %{}, :user) && Money.zero?(@course.price) -> %>
                <button
                  id="enroll-button"
                  phx-click="enroll_free"
                  class="btn btn-success w-full gap-2"
                >
                  <.icon name="hero-check-circle" class="w-6 h-6" /> Enroll Now - It's Free!
                </button>

                <%!-- Logged in, not enrolled, paid course --%>
              <% !@enrolled && Map.has_key?(@current_scope || %{}, :user) && !Money.zero?(@course.price) -> %>
                <button
                  id="purchase-button"
                  phx-click="purchase"
                  phx-disable-with="Redirecting to checkout..."
                  class="btn btn-primary w-full gap-2"
                >
                  <.icon name="hero-shopping-cart" class="w-6 h-6" /> Purchase Course
                </button>

                <%!-- Not logged in --%>
              <% true -> %>
                <.link
                  navigate={~p"/users/log-in"}
                  class="btn btn-primary w-full gap-2"
                >
                  <.icon name="hero-arrow-right-on-rectangle" class="w-6 h-6" /> Sign in to Enroll
                </.link>
            <% end %>
          </div>
        </div>
      </div>
    </article>

    <%!-- Course Content Section --%>
    <div class="flex flex-col lg:grid lg:grid-cols-3 gap-4 sm:gap-6">
      <%!-- Main Content --%>
      <div class="lg:col-span-2 space-y-4 sm:space-y-6 order-2 lg:order-1">
        <%!-- Course Description --%>
        <%= if @course.body do %>
          <section class="card bg-base-100 shadow-lg border border-base-300">
            <div class="card-body p-4 sm:p-6">
              <h2 class="card-title text-xl sm:text-2xl">About This Course</h2>
              <div class="prose prose-sm sm:prose max-w-none text-base-content/80">
                {@course.body}
              </div>
            </div>
          </section>
        <% end %>
      </div>

      <%!-- Sidebar - Curriculum --%>
      <div class="lg:col-span-1 order-1 lg:order-2">
        <section
          id="curriculum"
          class="card bg-base-100 shadow-lg border border-base-300 lg:sticky lg:top-6"
        >
          <div class="card-body p-4 sm:p-6">
            <h3 class="card-title text-lg sm:text-xl flex items-center gap-2">
              <.icon name="hero-list-bullet" class="w-5 h-5 sm:w-6 sm:h-6 text-primary" />
              Course Content
            </h3>

            <%= if Enum.empty?(@lessons) do %>
              <p class="text-base-content/60 text-center py-6 sm:py-8 text-sm sm:text-base">
                No lessons available yet
              </p>
            <% else %>
              <ol class="space-y-2 mt-3 sm:mt-4">
                <%= for lesson <- @lessons do %>
                  <li class="flex items-start p-2 sm:p-3 rounded-lg hover:bg-base-200 transition-colors">
                    <span class="badge badge-primary badge-xs sm:badge-sm mr-2 sm:mr-3 mt-0.5">
                      {lesson.order}
                    </span>
                    <div class="flex-1 min-w-0">
                      <p class="text-xs sm:text-sm font-medium text-base-content truncate">
                        {lesson.title}
                      </p>
                      <%= if lesson.duration do %>
                        <p class="text-xs text-base-content/60 flex items-center gap-1 mt-1">
                          <.icon name="hero-clock" class="w-3 h-3" />
                          {format_duration(lesson.duration)}
                        </p>
                      <% end %>
                    </div>
                  </li>
                <% end %>
              </ol>
            <% end %>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layouts.app>
