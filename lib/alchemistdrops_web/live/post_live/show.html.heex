<Layouts.app flash={@flash} current_scope={@current_scope}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="mb-8">
      <.link
        navigate={~p"/blog"}
        class="inline-flex items-center gap-2 text-indigo-600 hover:text-indigo-800 transition-colors font-medium"
      >
        <.icon name="hero-arrow-left" class="w-5 h-5" /> Back to all posts
      </.link>
    </nav>

    <header class="mb-12">
      <div
        class="relative h-96 -mx-4 sm:-mx-6 lg:-mx-8 mb-8 rounded-lg overflow-hidden"
        style={"background: #{@post.background}"}
      >
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent flex items-end">
          <div class="p-8 lg:p-12 w-full">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 drop-shadow-lg">
              {@post.title}
            </h1>
            <div class="flex items-center gap-6 text-white/90">
              <time datetime={@post.inserted_at} class="flex items-center gap-2">
                <.icon name="hero-calendar" class="w-5 h-5" />
                {format_date(@post.inserted_at)}
              </time>
              <span class="flex items-center gap-2">
                <.icon name="hero-eye" class="w-5 h-5" />
                {@post.views} views
              </span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <section class="prose prose-lg prose-indigo max-w-none">
      <div class="text-gray-700 leading-relaxed whitespace-pre-wrap">
        {@post.body}
      </div>
    </section>

    <footer class="mt-12 pt-8 border-t border-gray-200">
      <div class="flex items-center justify-between">
        <time datetime={@post.updated_at} class="text-sm text-gray-500">
          Last updated: {format_date(@post.updated_at)}
        </time>

        <.link
          navigate={~p"/blog"}
          class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium"
        >
          View all posts <.icon name="hero-arrow-right" class="w-4 h-4" />
        </.link>
      </div>
    </footer>
  </article>
</Layouts.app>
