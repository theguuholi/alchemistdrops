<div class="flex flex-col lg:flex-row min-h-screen bg-base-200 w-full max-w-full overflow-x-hidden">
  <%!-- Mobile Header Bar --%>
  <div class="lg:hidden sticky top-0 z-40 bg-gradient-to-r from-primary to-secondary px-3 py-2.5 w-full">
    <div class="flex items-center justify-between gap-2 w-full">
      <.link
        navigate={~p"/courses/#{@course.id}"}
        class="flex-shrink-0 flex items-center text-primary-content/80 hover:text-primary-content transition-colors"
      >
        <.icon name="hero-arrow-left" class="w-5 h-5" />
        <span class="sr-only">Back</span>
      </.link>
      <h2 class="text-sm font-semibold text-primary-content truncate min-w-0 flex-1 text-center px-2">
        {@course.title}
      </h2>
      <div class="drawer drawer-end flex-shrink-0">
        <input id="lesson-drawer" type="checkbox" class="drawer-toggle" />
        <div class="drawer-content">
          <label for="lesson-drawer" class="btn btn-ghost btn-sm text-primary-content p-1">
            <.icon name="hero-list-bullet" class="w-5 h-5" />
            <span class="sr-only">Lessons</span>
          </label>
        </div>
        <div class="drawer-side z-50">
          <label for="lesson-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
          <div class="bg-base-100 min-h-full w-[280px] max-w-[85vw]">
            <%!-- Drawer Header --%>
            <div class="p-4 border-b border-base-300 bg-gradient-to-r from-primary to-secondary">
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-bold text-primary-content">Lessons</h3>
                <label
                  for="lesson-drawer"
                  class="btn btn-ghost btn-sm btn-square text-primary-content"
                >
                  <.icon name="hero-x-mark" class="w-5 h-5" />
                </label>
              </div>
              <p class="text-sm text-primary-content/80 mt-1">
                {length(@lessons)} Lessons
              </p>
            </div>
            <%!-- Drawer Lessons List --%>
            <nav class="p-3 space-y-2 overflow-y-auto max-h-[calc(100vh-100px)]">
              <%= for {lesson, index} <- Enum.with_index(@lessons) do %>
                <label for="lesson-drawer" class="block">
                  <button
                    phx-click="select_lesson"
                    phx-value-id={lesson.id}
                    class={[
                      "w-full text-left p-3 rounded-lg transition-all duration-200",
                      lesson.id == @current_lesson.id &&
                        "bg-primary text-primary-content shadow-md",
                      lesson.id != @current_lesson.id && "bg-base-200 hover:bg-base-300"
                    ]}
                  >
                    <div class="flex items-start gap-2">
                      <span class={[
                        "flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center font-semibold text-xs",
                        lesson.id == @current_lesson.id &&
                          "bg-primary-content/20 text-primary-content",
                        lesson.id != @current_lesson.id && "bg-primary/20 text-primary"
                      ]}>
                        {index + 1}
                      </span>
                      <div class="flex-1 min-w-0">
                        <p class={[
                          "font-medium text-sm break-words",
                          lesson.id == @current_lesson.id && "text-primary-content",
                          lesson.id != @current_lesson.id && "text-base-content"
                        ]}>
                          {lesson.title}
                        </p>
                        <%= if lesson.duration do %>
                          <p class={[
                            "text-xs mt-1 flex items-center gap-1",
                            lesson.id == @current_lesson.id && "text-primary-content/80",
                            lesson.id != @current_lesson.id && "text-base-content/60"
                          ]}>
                            <.icon name="hero-clock" class="w-3 h-3 flex-shrink-0" />
                            {format_duration(lesson.duration)}
                          </p>
                        <% end %>
                      </div>
                      <%= if lesson.id == @current_lesson.id do %>
                        <.icon
                          name="hero-play-circle"
                          class="w-4 h-4 text-primary-content flex-shrink-0"
                        />
                      <% end %>
                    </div>
                  </button>
                </label>
              <% end %>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%!-- Desktop Sidebar - Lesson Navigation --%>
  <aside class="hidden lg:flex w-80 bg-base-100 border-r border-base-300 flex-col flex-shrink-0 h-screen sticky top-0">
    <%!-- Course Header --%>
    <div class="p-6 border-b border-base-300 bg-gradient-to-r from-primary to-secondary">
      <.link
        navigate={~p"/courses/#{@course.id}"}
        class="flex items-center text-primary-content/80 hover:text-primary-content mb-3 transition-colors gap-2"
      >
        <.icon name="hero-arrow-left" class="w-5 h-5" /> Back to Course
      </.link>
      <h2 class="text-xl font-bold text-primary-content break-words">
        {@course.title}
      </h2>
      <p class="text-sm text-primary-content/80 mt-1">
        {length(@lessons)} Lessons
      </p>
    </div>

    <%!-- Lessons List --%>
    <nav class="flex-1 overflow-y-auto p-4 space-y-2">
      <%= for {lesson, index} <- Enum.with_index(@lessons) do %>
        <button
          phx-click="select_lesson"
          phx-value-id={lesson.id}
          class={[
            "w-full text-left p-4 rounded-lg transition-all duration-200",
            lesson.id == @current_lesson.id && "bg-primary text-primary-content shadow-md",
            lesson.id != @current_lesson.id && "bg-base-200 hover:bg-base-300"
          ]}
        >
          <div class="flex items-start">
            <span class={[
              "flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-semibold text-sm mr-3",
              lesson.id == @current_lesson.id && "bg-primary-content/20 text-primary-content",
              lesson.id != @current_lesson.id && "bg-primary/20 text-primary"
            ]}>
              {index + 1}
            </span>
            <div class="flex-1 min-w-0">
              <p class={[
                "font-medium text-sm break-words",
                lesson.id == @current_lesson.id && "text-primary-content",
                lesson.id != @current_lesson.id && "text-base-content"
              ]}>
                {lesson.title}
              </p>
              <%= if lesson.duration do %>
                <p class={[
                  "text-xs mt-1 flex items-center gap-1",
                  lesson.id == @current_lesson.id && "text-primary-content/80",
                  lesson.id != @current_lesson.id && "text-base-content/60"
                ]}>
                  <.icon name="hero-clock" class="w-3 h-3" />
                  {format_duration(lesson.duration)}
                </p>
              <% end %>
            </div>
            <%= if lesson.id == @current_lesson.id do %>
              <.icon
                name="hero-play-circle"
                class="w-5 h-5 text-primary-content flex-shrink-0 ml-2"
              />
            <% end %>
          </div>
        </button>
      <% end %>
    </nav>
  </aside>

  <%!-- Main Content Area --%>
  <div class="flex-1 flex flex-col min-w-0 w-full">
    <%!-- Lesson Content --%>
    <main role="main" class="flex-1 bg-base-100 w-full">
      <article class="max-w-4xl mx-auto px-3 py-4 sm:px-6 sm:py-6 lg:px-8 lg:py-8 w-full">
        <%!-- Lesson Header --%>
        <header class="mb-4 sm:mb-6 lg:mb-8">
          <h1 class="text-xl sm:text-2xl lg:text-4xl font-bold text-base-content mb-2 sm:mb-3 lg:mb-4 break-words">
            {@current_lesson.title}
          </h1>
          <%= if @current_lesson.description do %>
            <p class="text-sm sm:text-base lg:text-lg text-base-content/70 break-words">
              {@current_lesson.description}
            </p>
          <% end %>
        </header>

        <%!-- Video Player --%>
        <%= if @current_lesson.video_url do %>
          <div class="mb-4 sm:mb-6 lg:mb-8 rounded-lg lg:rounded-xl overflow-hidden shadow-lg lg:shadow-2xl bg-base-300 w-full">
            <%= case video_embed_info(@current_lesson.video_url) do %>
              <% {:youtube, embed_url} -> %>
                <iframe
                  src={embed_url}
                  title={@current_lesson.title}
                  class="w-full aspect-video"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                >
                </iframe>
              <% {:video, url} -> %>
                <video controls class="w-full aspect-video" src={url}>
                  Your browser does not support the video tag.
                </video>
              <% _ -> %>
            <% end %>
          </div>
        <% end %>

        <%!-- Lesson Content --%>
        <%= if @current_lesson.content do %>
          <div class="prose prose-sm sm:prose-base lg:prose-lg max-w-none card bg-base-100 shadow-lg border border-base-300 overflow-hidden">
            <div class="card-body p-3 sm:p-4 lg:p-6 overflow-x-auto">
              {@current_lesson.content}
            </div>
          </div>
        <% end %>
      </article>
    </main>

    <%!-- Navigation Footer --%>
    <footer class="bg-base-100 border-t border-base-300 px-3 py-3 sm:px-6 sm:py-4 lg:px-8 lg:py-6 w-full">
      <div class="max-w-4xl mx-auto flex items-center justify-between gap-2 sm:gap-4">
        <%!-- Previous Button --%>
        <%= if @has_prev do %>
          <button
            id="prev-lesson"
            phx-click="prev_lesson"
            class="btn btn-ghost btn-sm gap-1 sm:gap-2 flex-shrink-0"
          >
            <.icon name="hero-arrow-left" class="w-4 h-4" />
            <span class="hidden sm:inline">Previous</span>
          </button>
        <% else %>
          <button class="btn btn-disabled btn-sm gap-1 sm:gap-2 flex-shrink-0">
            <.icon name="hero-arrow-left" class="w-4 h-4" />
            <span class="hidden sm:inline">Previous</span>
          </button>
        <% end %>

        <%!-- Progress Indicator --%>
        <div class="text-center flex-1 min-w-0 px-1">
          <p class="text-xs text-base-content/70 mb-1">
            <span class="sm:hidden">
              {Enum.find_index(@lessons, &(&1.id == @current_lesson.id)) + 1}/{length(@lessons)}
            </span>
            <span class="hidden sm:inline">
              Lesson {Enum.find_index(@lessons, &(&1.id == @current_lesson.id)) + 1} of {length(@lessons)}
            </span>
          </p>
          <progress
            class="progress progress-primary w-full max-w-[200px]"
            value={Enum.find_index(@lessons, &(&1.id == @current_lesson.id)) + 1}
            max={length(@lessons)}
          >
          </progress>
        </div>

        <%!-- Next Button --%>
        <%= if @has_next do %>
          <button
            id="next-lesson"
            phx-click="next_lesson"
            class="btn btn-primary btn-sm gap-1 sm:gap-2 flex-shrink-0"
          >
            <span class="hidden sm:inline">Next</span>
            <.icon name="hero-arrow-right" class="w-4 h-4" />
          </button>
        <% else %>
          <div class="badge badge-success gap-1 p-2 sm:p-3 flex-shrink-0">
            <.icon name="hero-check-circle" class="w-3 h-3 sm:w-4 sm:h-4" />
            <span class="text-xs">Done</span>
          </div>
        <% end %>
      </div>
    </footer>
  </div>
</div>
