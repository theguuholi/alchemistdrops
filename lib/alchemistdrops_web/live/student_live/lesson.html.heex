<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="flex flex-col lg:flex-row -mx-4 sm:-mx-6 lg:-mx-8 -my-6 sm:-my-8 min-h-[calc(100vh-4rem)] bg-base-200">
    <%!-- Mobile Header with Menu Toggle --%>
    <div class="lg:hidden sticky top-0 z-40 bg-gradient-to-r from-primary to-secondary p-4">
      <div class="flex items-center justify-between">
        <div class="flex-1 min-w-0">
          <.link
            navigate={~p"/courses/#{@course.id}"}
            class="flex items-center text-primary-content/80 hover:text-primary-content text-sm gap-1"
          >
            <.icon name="hero-arrow-left" class="w-4 h-4" /> Back
          </.link>
          <h2 class="text-lg font-bold text-primary-content truncate mt-1">
            {@course.title}
          </h2>
        </div>
        <label for="lesson-drawer" class="btn btn-ghost btn-sm text-primary-content">
          <.icon name="hero-bars-3" class="w-5 h-5" />
          <span class="text-xs">Lessons</span>
        </label>
      </div>
    </div>

    <%!-- Drawer for mobile lesson list --%>
    <div class="drawer lg:drawer-open flex-1">
      <input id="lesson-drawer" type="checkbox" class="drawer-toggle" />

      <%!-- Main Content Area --%>
      <div class="drawer-content flex flex-col">
        <main role="main" class="flex-1 overflow-y-auto bg-base-100">
          <article class="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
            <%!-- Lesson Header --%>
            <header class="mb-6 sm:mb-8">
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-base-content mb-3 sm:mb-4">
                {@current_lesson.title}
              </h1>
              <%= if @current_lesson.description do %>
                <p class="text-base sm:text-lg text-base-content/70">
                  {@current_lesson.description}
                </p>
              <% end %>
            </header>

            <%!-- Video Player --%>
            <%= if @current_lesson.video_url do %>
              <div class="mb-6 sm:mb-8 rounded-xl overflow-hidden shadow-2xl bg-base-300">
                <%= case video_embed_info(@current_lesson.video_url) do %>
                  <% {:youtube, embed_url} -> %>
                    <iframe
                      src={embed_url}
                      title={@current_lesson.title}
                      class="w-full aspect-video"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allowfullscreen
                    >
                    </iframe>
                  <% {:video, url} -> %>
                    <video controls class="w-full aspect-video" src={url}>
                      Your browser does not support the video tag.
                    </video>
                  <% _ -> %>
                <% end %>
              </div>
            <% end %>

            <%!-- Lesson Content --%>
            <%= if @current_lesson.content do %>
              <div class="prose prose-sm sm:prose-base lg:prose-lg max-w-none card bg-base-100 shadow-lg border border-base-300">
                <div class="card-body p-4 sm:p-6">
                  {@current_lesson.content}
                </div>
              </div>
            <% end %>
          </article>
        </main>

        <%!-- Navigation Footer --%>
        <footer class="bg-base-100 border-t border-base-300 px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
          <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
            <%!-- Previous Button --%>
            <%= if @has_prev do %>
              <button
                id="prev-lesson"
                phx-click="prev_lesson"
                class="btn btn-ghost gap-2 w-full sm:w-auto order-2 sm:order-1"
              >
                <.icon name="hero-arrow-left" class="w-5 h-5" /> Previous
              </button>
            <% else %>
              <button class="btn btn-disabled gap-2 w-full sm:w-auto order-2 sm:order-1">
                <.icon name="hero-arrow-left" class="w-5 h-5" /> Previous
              </button>
            <% end %>

            <%!-- Progress Indicator --%>
            <div class="text-center order-1 sm:order-2 w-full sm:w-auto">
              <p class="text-sm text-base-content/70 mb-2">
                Lesson {Enum.find_index(@lessons, &(&1.id == @current_lesson.id)) |> Kernel.+(1)} of {length(@lessons)}
              </p>
              <progress
                class="progress progress-primary w-full sm:w-48"
                value={Enum.find_index(@lessons, &(&1.id == @current_lesson.id)) + 1}
                max={length(@lessons)}
              >
              </progress>
            </div>

            <%!-- Next Button --%>
            <%= if @has_next do %>
              <button
                id="next-lesson"
                phx-click="next_lesson"
                class="btn btn-primary gap-2 w-full sm:w-auto order-3"
              >
                Next <.icon name="hero-arrow-right" class="w-5 h-5" />
              </button>
            <% else %>
              <div class="badge badge-success badge-lg gap-2 p-4 order-3">
                <.icon name="hero-check-circle" class="w-5 h-5" /> Complete!
              </div>
            <% end %>
          </div>
        </footer>
      </div>

      <%!-- Sidebar - Lesson Navigation --%>
      <aside class="drawer-side z-50">
        <label for="lesson-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
        <div class="w-72 sm:w-80 bg-base-100 border-r border-base-300 flex flex-col min-h-full">
          <%!-- Course Header --%>
          <div class="p-4 sm:p-6 border-b border-base-300 bg-gradient-to-r from-primary to-secondary">
            <.link
              navigate={~p"/courses/#{@course.id}"}
              class="flex items-center text-primary-content/80 hover:text-primary-content mb-3 transition-colors gap-2 text-sm"
            >
              <.icon name="hero-arrow-left" class="w-4 h-4" /> Back to Course
            </.link>
            <h2 class="text-lg sm:text-xl font-bold text-primary-content truncate">
              {@course.title}
            </h2>
            <p class="text-sm text-primary-content/80 mt-1">
              {length(@lessons)} Lessons
            </p>
          </div>

          <%!-- Lessons List --%>
          <nav class="flex-1 overflow-y-auto p-3 sm:p-4 space-y-2">
            <%= for {lesson, index} <- Enum.with_index(@lessons) do %>
              <button
                phx-click="select_lesson"
                phx-value-id={lesson.id}
                class={[
                  "w-full text-left p-3 sm:p-4 rounded-lg transition-all duration-200",
                  lesson.id == @current_lesson.id && "bg-primary text-primary-content shadow-md",
                  lesson.id != @current_lesson.id && "bg-base-200 hover:bg-base-300"
                ]}
              >
                <div class="flex items-start">
                  <span class={[
                    "flex-shrink-0 w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center font-semibold text-xs sm:text-sm mr-3",
                    lesson.id == @current_lesson.id && "bg-primary-content/20 text-primary-content",
                    lesson.id != @current_lesson.id && "bg-primary/20 text-primary"
                  ]}>
                    {index + 1}
                  </span>
                  <div class="flex-1 min-w-0">
                    <p class={[
                      "font-medium text-sm truncate",
                      lesson.id == @current_lesson.id && "text-primary-content",
                      lesson.id != @current_lesson.id && "text-base-content"
                    ]}>
                      {lesson.title}
                    </p>
                    <%= if lesson.duration do %>
                      <p class={[
                        "text-xs mt-1 flex items-center gap-1",
                        lesson.id == @current_lesson.id && "text-primary-content/80",
                        lesson.id != @current_lesson.id && "text-base-content/60"
                      ]}>
                        <.icon name="hero-clock" class="w-3 h-3" />
                        {format_duration(lesson.duration)}
                      </p>
                    <% end %>
                  </div>
                  <%= if lesson.id == @current_lesson.id do %>
                    <.icon
                      name="hero-play-circle"
                      class="w-5 h-5 text-primary-content flex-shrink-0 ml-2"
                    />
                  <% end %>
                </div>
              </button>
            <% end %>
          </nav>
        </div>
      </aside>
    </div>
  </div>
</Layouts.app>
